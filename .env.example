# Telegram Bot Token — @BotFather üzerinden alın
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Bildirimlerin gideceği sohbet ID'si (kendi ID'nizi öğrenmek için bota /id yazabilirsiniz)
TELEGRAM_CHAT_ID=

# Slot kontrol aralığı (saniye). Varsayılan 300 (5 dakika)
CHECK_INTERVAL_SECONDS=300

# VFS oturum bilgileri (isteğe bağlı). Bazı ülkelerde slot görmek için giriş gereklidir.
# Her ülke için ayrı ayrı girilebilir; countries.json'daki "key" ile eşleştirilir.
# Örnekler:
# VFS_FR_EMAIL=ornek@gmail.com
# VFS_FR_PASSWORD=sifreniz
# VFS_FR_IMAP_APP_PASSWORD=gmail_uygulama_sifreniz
#
# Hollanda ve Norveç için giriş ZORUNLU (Cloudflare koruması):
# VFS_NETHERLANDS_EMAIL=ornek@gmail.com
# VFS_NETHERLANDS_PASSWORD=sifreniz
# VFS_NETHERLANDS_IMAP_APP_PASSWORD=gmail_uygulama_sifreniz
#
# VFS_NORWAY_EMAIL=ornek@gmail.com
# VFS_NORWAY_PASSWORD=sifreniz
# VFS_NORWAY_IMAP_APP_PASSWORD=gmail_uygulama_sifreniz
